# --- Content guard (heuristic malware / fake-torrent block) ---
# Master kill switch. true (default) blocks torrents that contain executables,
# have no playable video, or match fake-torrent patterns — before they download.
# Set to false to disable entirely (behaves exactly as before the guard existed).
CONTENT_GUARD_ENABLED=true
# Advanced (optional) — JSON arrays to override the built-in lists, and the
# opt-in structural heuristic. Leave unset to use the defaults in app/config.py.
# BLOCKED_EXTENSIONS=[".exe",".scr",".msi",".iso",".bin"]
# VIDEO_EXTENSIONS=[".mp4",".mkv",".m4v",".ts"]
# FAKE_TORRENT_HEURISTICS=false

# --- Sidecar subtitles ---
# Every one of these is env-overridable the moment its field exists in
# app/config.py: pydantic-settings runs with the default extra='forbid', which
# applies only to UNdeclared keys — so a key here without its Settings field
# crashes the backend at import, and a declared field needs nothing further to be
# settable. Leave unset to use the defaults in app/config.py.
# Which sidecars are LISTED in the picker, and which of those are actually
# CONVERTED to WebVTT and served. .ass/.ssa are listed, never converted. Never
# put a subtitle extension in VIDEO_EXTENSIONS — see the comment in config.py.
# SUBTITLE_EXTENSIONS=[".srt",".vtt",".ass",".ssa"]
# SUBTITLE_CONVERTIBLE_EXTENSIONS=[".srt",".vtt"]
# SUBTITLE_MAX_BYTES=4194304
# Piece-level admission: the span cap (whole pieces, not bytes) and how long to
# wait for the span before withdrawing the admission.
# SUBTITLE_ADMIT_MAX_PIECES=4
# SUBTITLE_ADMIT_BUDGET_MS=45000
# Fallback text encoding for sidecars that are neither UTF-8 nor cp1252 — e.g.
# cp1251 for a Cyrillic library. Unset means such a file is refused, not served
# as mojibake.
# SUBTITLE_ENCODING=cp1251
