# Copy to .env before `make up`. Docker Compose reads this file twice: once to
# interpolate ${VARS} in docker-compose.yml, and once as `env_file:` for the db,
# backend and frontend containers.
#
# ⚠ The backend's Settings model runs with pydantic-settings' default
# extra='forbid', so every key it reads must be a declared field on
# backend/app/config.py — an undeclared one crashes the backend at IMPORT. In
# compose these arrive as environment variables, which pydantic ignores when
# unknown; a local, non-docker run that reads this file as a real dotenv is the
# case that dies. NEXT_PUBLIC_API_URL at the bottom is Next-only and already
# such a key.

# ─── API ──────────────────────────────────────────────────────
API_V1_STR=/api/v1
PROJECT_NAME=Freeflix API
ENVIRONMENT=development

# ─── Scraping ─────────────────────────────────────────────────
YIFY_URL=https://en.yts-official.mx
YIFY_URL_BROWSE_URL=https://en.yts-official.mx/browse-movies
RARBG_URL=https://en.rarbg-official.com/{path}
REQUEST_RATE_LIMIT=3

# ─── External API keys ────────────────────────────────────────
OMDB_API_KEY=your_omdb_api_key_here
TMDB_API_KEY=your_tmdb_api_key_here

# ─── Torrent ──────────────────────────────────────────────────
DEFAULT_DOWNLOAD_PATH=./downloads
LISTEN_INTERFACES=0.0.0.0:6881
PORT_RANGE_START=6881
PORT_RANGE_END=6891
MAX_ACTIVE_DOWNLOADS=3

# ─── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO

# ─── Database ─────────────────────────────────────────────────
# Used by docker compose for both the `db` container and the backend.
# POSTGRES_HOST / POSTGRES_PORT are injected by compose (host=db, port=5432).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=freeflix
# For a local (non-docker) run the backend falls back to SQLite at:
DB_PATH=./freeflix.db

# ─── Instance claim / auth ────────────────────────────────────
# First boot prints a claim code; /claim turns this instance into a claimed,
# invite-only one. See README "First run".

# Development-only kill switch. false disables the session gate entirely — every
# request is treated as the owner. Never ship an internet-reachable instance
# with this off.
AUTH_ENABLED=true

# Session cookie name. Only change it if something else on the host collides.
#COOKIE_NAME=ff_session

# Set true ONLY when the app is served over HTTPS. A Secure cookie is silently
# dropped by the browser on plain http://localhost:3001 — sign-in then appears
# to succeed and nobody can ever get past /signin.
COOKIE_SECURE=false

# Lifetimes. Sessions slide on use; the emailed tokens are single-use.
SESSION_TTL_DAYS=30
MAGIC_LINK_TTL_MINUTES=20
INVITE_TTL_HOURS=72

# Public origin the emailed links point at. Must be what a browser can reach —
# compose maps host 3001 to the container's 3000. Behind a reverse proxy this is
# your real https:// hostname.
APP_PUBLIC_URL=http://localhost:3001

# Where the backend reaches Next.js server-to-server for the mail route.
# Compose sets this to the container name; leave it alone unless the frontend
# service is renamed.
FRONTEND_INTERNAL_URL=http://frontend:3000

# Browser origins allowed to send the session cookie. JSON array — a
# comma-separated list fails to parse and crashes the backend at import.
#CORS_ORIGINS=["http://localhost:3001","http://localhost:3000"]

# ─── Mail (Resend) ────────────────────────────────────────────
# Topology: FastAPI -> POST {FRONTEND_INTERNAL_URL}/api/internal/mail -> Resend.
# The Next route renders the React Email templates; the backend never talks to
# Resend directly.

# Shared secret for that internal hop. REQUIRED for email to work at all: with
# it unset the backend sends nothing and instead logs every magic link / invite
# URL at WARNING level, so a self-hosted instance with no mail provider is still
# fully usable (paste the link out of `make logs s=backend`).
#   openssl rand -hex 32
INTERNAL_MAIL_SECRET=

# Resend API key. Unset => the mail route still renders and returns the action
# URL, which the backend logs. Set it to actually deliver.
RESEND_API_KEY=

# Sender identity. resend.dev only delivers to the address that owns the Resend
# account; use a verified domain for real invites.
MAIL_FROM=FRÈ <onboarding@resend.dev>

# ─── Monitoring (optional) ────────────────────────────────────
#SENTRY_DSN=https://your_sentry_dsn

# ─── Cron ─────────────────────────────────────────────────────
CRON_ENABLED=true
CACHE_MOVIES_FOR=365

# ─── Frontend ─────────────────────────────────────────────────
# Read by Next.js only. NEXT_PUBLIC_* is inlined into the browser bundle, so
# nothing secret goes here. (The frontend also consumes APP_PUBLIC_URL,
# INTERNAL_MAIL_SECRET, RESEND_API_KEY and MAIL_FROM from the sections above.)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
